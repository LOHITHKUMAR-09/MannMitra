# PostgreSQL connection
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/mannmitra

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme_generate_a_real_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — frontend origin
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Groq LLM API — for 1-on-1 human interaction and zero-shot semantic crisis evaluation
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
